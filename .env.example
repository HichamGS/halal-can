# ---------------------------------------------------------------------------
# Maghreb Connect – environment template (root .env for docker-compose)
# Copy to .env and adjust values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# ============================ Django / API =================================
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,web
# Comma-separated origins allowed by CORS (the React app origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
API_PAGE_SIZE=25
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_SUBMISSION=10/hour

# Superuser auto-created by backend/docker-entrypoint.sh on first boot
# (only if DJANGO_SUPERUSER_PASSWORD is set; change immediately after).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ============================ Database (PostGIS) ============================
DB_ENGINE=postgis
POSTGRES_DB=maghreb_connect
POSTGRES_USER=maghreb
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Exposed port on the host for local psql access (dev only).
POSTGRES_HOST_PORT=5432

# ============================ Redis / Celery ================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
USE_REDIS_CACHE=True

# Cache TTLs in seconds (keep 5–30 min per spec).
CACHE_TTL_PLACES=300
CACHE_TTL_PLACE=900
CACHE_TTL_TAXONOMY=1800

# ==================== External providers (server-side only) =================
# Google Places API key — used ONLY by the Django source adapter.
# It must NEVER be exposed to the browser bundle.
GOOGLE_PLACES_API_KEY=

# ============================ Frontend (Vite) ===============================
# Client-safe values only. Empty = use Vite dev proxy / Nginx same-origin.
VITE_API_BASE_URL=/api/v1
# MapLibre style URL — MUST be a self-hosted or licensed tile source in prod.
# Do NOT point this at the public OpenStreetMap tile server for production.
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_MAP_CENTER_LNG=-96.0
VITE_MAP_CENTER_LAT=58.0
VITE_MAP_ZOOM=3.5

# ============================ Ports / compose ===============================
# Host port that Nginx (single entrypoint) listens on.
HTTP_PORT=8080
# Dev-mode Vite server host port (hot reload).
WEB_DEV_PORT=5173
