# ---------------------------------------------------------------------------
# Maghreb Connect — Web frontend environment (client-safe values ONLY)
# NEVER put provider API keys here. The React app must only talk to OUR
# Django API; secrets (Google Places key, etc.) stay server-side.
# ---------------------------------------------------------------------------

# Base URL of the Django REST API (v1). Leave empty in dev to use the Vite
# proxy (/api/v1 -> http://localhost:8000/api/v1).
VITE_API_BASE_URL=/api/v1

# MapLibre style. MUST be a self-hosted / licensed tile source for production.
# The public OpenStreetMap tile server is NOT used for production traffic.
# Options: any valid MapLibre style URL (e.g. your own tile server,
# MapTiler/Carto with an attribution-compliant style JSON, etc.)
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_MAP_CENTER_LNG=-96.0
VITE_MAP_CENTER_LAT=58.0
VITE_MAP_ZOOM=3.5
